    <!--
        OWASP Dependency-Check Suppressions File

        Use this file to suppress false positives.
        Add suppressions for:
        1. Development/test dependencies that are not deployed to production
        2. Known issues that have been assessed and accepted
        3. False positives from the NVD database

        Format:
        <suppress>
           <notes>Explanation of why this is suppressed</notes>
           <filePath regex="true">.*dependency-name.*</filePath>
           <cve>CVE-YYYY-NNNNN</cve>
        </suppress>
    -->

