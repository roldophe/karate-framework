[
  {
    "httpRequest": {
      "method": "GET",
      "path": "/api/external/users/non-existent"
    },
    "httpResponse": {
      "statusCode": 404,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "error": "User not found",
        "message": "External user does not exist"
      }
    }
  },
  {
    "httpRequest": {
      "method": "GET",
      "path": "/api/external/users/.*"
    },
    "httpResponse": {
      "statusCode": 200,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "id": "ext-123",
        "name": "External User",
        "email": "external@example.com",
        "source": "external-api"
      }
    }
  },
  {
    "httpRequest": {
      "method": "POST",
      "path": "/api/external/validate"
    },
    "httpResponse": {
      "statusCode": 200,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "valid": true,
        "message": "Validation successful"
      }
    }
  }
]
